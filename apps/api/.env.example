PORT=4000
# postgres://user:pass@host:5432/db for Postgres, or a folder path for embedded PGlite.
DATABASE_URL=./.data/pglite
# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
# Create the demo organisation (demo@dealflow.dev / demo1234) on start.
SEED_DEMO=true
